{
  "manifest_version": 3,
  "name": "Бабусин помічник",
  "short_name": "Помічник",
  "version": "1.5.0",
  "description": "Проста головна сторінка, розклад трансляцій, голосовий пошук, новини, погода і спрощений YouTube.",
  "permissions": ["storage", "alarms", "tabs", "bookmarks", "sidePanel"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "src/pages/home.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Помічник: зберегти відео і налаштування"
  },
  "side_panel": {
    "default_path": "src/pages/panel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/yt-selectors.js", "src/content/scroll.js", "src/content/youtube.js"],
      "css": ["src/content/youtube.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["src/content/scroll.js", "src/content/facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["src/content/homebtn.js"],
      "run_at": "document_idle"
    }
  ]
}
